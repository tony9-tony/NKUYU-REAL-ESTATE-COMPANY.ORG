# HTTP port
PORT=3003

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres@localhost:5432/mkuyu_org

# PostgreSQL backup executable (use an absolute path on Windows)
PG_DUMP_PATH=pg_dump

# Allowed browser origins for the API
CORS_ORIGINS=http://localhost:3003

# Runtime root for uploads and backups
DATA_DIR=data

# Production deployments must set NODE_ENV=production and provide a unique
# SETUP_TOKEN before exposing first-run setup. Keep both values out of Git.
# TRUST_PROXY is optional; list only the reverse-proxy IPs/CIDRs that connect
# directly to this server (leave unset when the app is reached directly).
# NODE_ENV=production
# SETUP_TOKEN=
# TRUST_PROXY=10.0.0.10

# Public website: its origins (comma separated) and this API's public address,
# used for the picture links the website receives.
# PUBLIC_SITE_ORIGINS=https://www.example.co.tz
# PUBLIC_API_URL=https://system.example.co.tz

# Website AI assistant ("Ask MKUYU") - a local model through Ollama.
# It is given public information only. Leave as is to use the first Qwen
# model installed in Ollama on this computer; ASSISTANT_AI=0 turns it off.
ASSISTANT_AI=1
OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_TIMEOUT_MS=45000

# Customer SMS (notify/). Until an SMS account is set, SMS_PROVIDER=log only
# writes each message to the "Customer notices" list (System & backups) as a
# test; nothing is sent. SMS_PROVIDER=off turns SMS off completely.
# SMS_PROVIDER=nextsms
# NEXTSMS_USERNAME=
# NEXTSMS_PASSWORD=
# NEXTSMS_TEST=1            NextSMS's free test endpoint (nothing delivered)
# SMS_PROVIDER=beem
# BEEM_API_KEY=
# BEEM_SECRET_KEY=
# SMS_SENDER_ID=MKUYU       the sender name registered with TCRA
# SMS_COMPANY_NAME=MKUYU    the name at the start of every SMS
# SMS_LANGUAGE=sw           sw (Kiswahili) or en
# MKUYU_CONTACT_PHONE=0712 000 000   shown in overdue notices
# PUBLIC_SITE_URL=https://www.example.co.tz   link in new-property SMS
# SMS_DUE_DAYS=7,3,0        installment reminders: days before the due date
# SMS_OVERDUE_DAYS=1,7,14,30  overdue notices: days late (then every 30 days)
# SMS_QUIET_HOURS=20-8      no scheduled SMS between 20:00 and 08:00
# SMS_PAYMENTS=0 / SMS_REMINDERS=0 / SMS_OVERDUE=0 / SMS_ANNOUNCE=0   turn one kind off
# NOTIFY_EMAIL=0            no e-mail copies of fully-paid / overdue / new-property notices

# Diaspora customer portal (routes/customer.js). Sign-in codes go by e-mail,
# so SMTP above must be set for real customers.
# PUBLIC_SITE_URL=https://www.example.co.tz   link in the invitation e-mail
# MKUYU_CONTACT_EMAIL=info@example.co.tz
# CUSTOMER_SESSION_HOURS=24
# MKUYU_CONTACT_WHATSAPP=+255 712 000 000   Diaspora Desk WhatsApp shown in the customer portal
