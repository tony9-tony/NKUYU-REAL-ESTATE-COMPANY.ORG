{
  "name": "realestate-system",
  "version": "1.0.0",
  "private": true,
  "description": "Internal working system for real estate contracts, debts, and reports.",
  "type": "module",
  "scripts": {
    "start": "node backend/src/server.js",
    "dev": "node backend/src/server.js",
    "seed": "node backend/src/migrate.js --seed-only",
    "test:unit": "node --import ./test_support/guard.mjs unit_test.mjs",
    "test:e2e": "node --import ./test_support/guard.mjs e2e_test.mjs",
    "test:portal": "node --import ./test_support/guard.mjs portal_auth_test.mjs",
    "test:security": "node --import ./test_support/guard.mjs security_audit_test.mjs",
    "test:perf": "node --import ./test_support/guard.mjs perf_bench_test.mjs",
    "test:paginate": "node --import ./test_support/guard.mjs pagination_test.mjs",
    "test:workspace": "node --import ./test_support/guard.mjs workspace_test.mjs",
    "test:access": "node --import ./test_support/guard.mjs access_matrix_test.mjs",
    "test:frontend": "node --import ./test_support/guard.mjs frontend_smoke_test.mjs",
    "test:export": "node --import ./test_support/guard.mjs export_test.mjs",
    "test:demo": "node --import ./test_support/guard.mjs demo_account_test.mjs",
    "test:rotation": "node --import ./test_support/guard.mjs rotation_test.mjs",
    "test:data": "node data_integrity_check.mjs",
    "test:partial": "node --import ./test_support/guard.mjs partial_status_test.mjs",
    "test:admin": "node --import ./test_support/guard.mjs admin_endpoints_test.mjs",
    "test:pricing": "node --import ./test_support/guard.mjs pricing_test.mjs",
    "test:clientflow": "node --import ./test_support/guard.mjs client_workflow_test.mjs",
    "test:images": "node --import ./test_support/guard.mjs property_images_test.mjs",
    "test:tasks": "node --import ./test_support/guard.mjs task_assignment_test.mjs",
    "test:staffadmin": "node --import ./test_support/guard.mjs staff_admin_test.mjs",
    "test:isolated": "node --import ./test_support/guard.mjs test_support/verify_isolation.mjs",
    "test:audit": "node --import ./test_support/guard.mjs ui_audit_regression.mjs",
    "test": "npm run test:unit && npm run test:access && npm run test:frontend && npm run test:e2e"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "docx": "^9.7.2",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jszip": "^3.10.1",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "8.16.3",
    "pptxgenjs": "^4.0.1"
  }
}
