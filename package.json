  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "docx": "^9.7.2",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "jszip": "^3.10.1",
    "multer": "^2.4.0",
    "pdfkit": "^0.20.2",
    "pg": "8.16.3",
    "pptxgenjs": "^4.0.1"
  }
