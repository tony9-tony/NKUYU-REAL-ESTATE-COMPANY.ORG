    "test:partial": "node --import ./test_support/guard.mjs partial_status_test.mjs",
    "test:admin": "node --import ./test_support/guard.mjs admin_endpoints_test.mjs",
    "test:pricing": "node --import ./test_support/guard.mjs pricing_test.mjs",
    "test:clientflow": "node --import ./test_support/guard.mjs client_workflow_test.mjs",
    "test:images": "node --import ./test_support/guard.mjs property_images_test.mjs",
    "test:tasks": "node --import ./test_support/guard.mjs task_assignment_test.mjs",
    "test:staffadmin": "node --import ./test_support/guard.mjs staff_admin_test.mjs",
    "test:public": "node --import ./test_support/guard.mjs public_api_test.mjs",
    "test:secfix": "node --import ./test_support/guard.mjs security_fixes_test.mjs",
    "test:final": "node --import ./test_support/guard.mjs final_checks_test.mjs",
    "test:handwritten": "node --import ./test_support/guard.mjs handwritten_fixes_test.mjs",
    "test:docx": "node tools/contract_docx_check.mjs",
    "test:isolated": "node --import ./test_support/guard.mjs test_support/verify_isolation.mjs",
    "test:audit": "node --import ./test_support/guard.mjs ui_audit_regression.mjs",
    "test": "npm run test:unit && npm run test:access && npm run test:frontend && npm run test:e2e",
    "test:backup": "node --import ./test_support/guard.mjs backup_test.mjs",
    "test:mail": "node --import ./test_support/guard.mjs mail_test.mjs",
    "test:assistant": "node --import ./test_support/guard.mjs assistant_test.mjs",
    "test:buildings": "node --import ./test_support/guard.mjs building_test.mjs",
    "test:notices": "node notifications_test.mjs",
    "test:notices:db": "node --import ./test_support/guard.mjs notifications_db_test.mjs",
    "test:customer-portal": "node --import ./test_support/guard.mjs customer_portal_test.mjs",
    "test:diaspora-desk": "node --import ./test_support/guard.mjs diaspora_desk_test.mjs"
